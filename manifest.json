{
  "manifest_version": 3,
  "name": "e-typing Speed Master Pro",
  "version": "1.1.0",
  "description": "Auto typing tool cho e-typing.ne.jp: Tự động trích xuất Romaji, dispatch phím, tùy chỉnh WPM và độ chính xác linh hoạt.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "e-typing Speed Master Pro",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.e-typing.ne.jp/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/hide.css"
      ],
      "matches": [
        "*://*.e-typing.ne.jp/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.e-typing.ne.jp/*"
      ],
      "js": [
        "content/dispatcher.js",
        "content/extractor.js",
        "content/engine.js",
        "content/content.js",
        "content/hotkey.js",
        "content/settings.js"
        "content/keyboard.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
